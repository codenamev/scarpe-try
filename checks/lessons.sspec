---
display: native
timeout: 90
----------- app code
load "@TRY_RUBY@"
----------- test code
app = Shoes.APPS.first
lesson = -> { app.instance_variable_get(:@lesson) }
done = -> { app.instance_variable_get(:@done) }
log = -> { app.instance_variable_get(:@log).contents.map(&:text) }
canvas = -> { app.instance_variable_get(:@canvas).contents }
said = -> { para("@said").text }
enter = lambda do |code|
  type_text code
  press_key "\n"
end
keepsake = -> { JSON.parse(File.read(Keepsake::FILE)) }

click_on "Come in and try!"
advance 0.3
assert_equal 0, lesson.()

# lesson 1: add two numbers, by clicking the code chip to paste it
click_on "2 + 6"
assert_equal "2 + 6", edit_line.text, "the chip pastes its code"
press_key "\n"
assert_equal [">> 2 + 6", "=> 8", "  * lesson 1 done *"], log.().last(3)
assert_equal "Eight! A fine round number. It wears a belt.", said.()
advance 1
assert_equal 1, lesson.()
assert_includes paras.map(&:text), "Words wear quotes"

# lesson 2 learns your name, and the next lessons use it
enter.('"Vale"')
advance 1
assert_equal "Vale", keepsake.()["name"]
assert_includes paras.map(&:text), '"Vale".reverse', "the chip speaks your name"

# a wrong answer does not pass the lesson
enter.("40 + 2")
assert_equal 2, lesson.()
enter.('"Vale".reverse')
assert_equal '=> "elaV"', log.()[-2]
advance 1

# the rest, each with its own example (swapping in the name)
tries = LESSONS.map(&:try)
(3...LESSONS.size).each do |i|
  assert_equal i, lesson.(), "on lesson #{i + 1}"
  enter.(tries[i].gsub("%{quoted}", '"Vale"'))
  assert_includes done.(), i, "lesson #{i + 1} (#{LESSONS[i].title}) passed with #{tries[i]}"
  advance 1.3
end

# the lessons along the way did what they said
all = log.()
assert all.any? { |l| l.match?(/\ANoMethodError: undefined method .reverse. for .*Integer/) }, "40.reverse went red"
assert_includes all, "Odelay! Odelay! Odelay! "
assert_includes all, "=> \"CHUNKY BACON!\""
assert_includes all, "  * every lesson done! *"
assert_equal (0...LESSONS.size).to_a, keepsake.()["done"]
assert_equal "play", keepsake.()["mode"]
assert_includes paras.map(&:text), "Anything goes", "the playground card after the last lesson"

# the finale rains bacon on the canvas, then tidies up
assert_operator canvas.().size, :>=, 10
advance 5
assert_empty canvas.(), "the canvas is clear after the rain"

# the dots on the path are all ruby now
assert app.instance_variable_get(:@dots).all? { |d| d.style[:fill].to_s.downcase.include?("cc342d") || d.fill.to_s.downcase.include?("cc342d") }
